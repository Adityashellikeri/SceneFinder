<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Tech Obsidian Background -->
    <path
        android:pathData="M16,6 L92,6 A10,10 0 0 1 102,16 L102,92 A10,10 0 0 1 92,102 L16,102 A10,10 0 0 1 6,92 L6,16 A10,10 0 0 1 16,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF080C16" />
                <item android:offset="0.5" android:color="#FF0E172A" />
                <item android:offset="1.0" android:color="#FF020617" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Cinematic Diamond Viewfinder Frame -->
    <path
        android:pathData="M54,16 L88,54 L54,92 L20,54 Z"
        android:strokeWidth="2.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="16"
                android:endX="88"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00F2FE" />
                <item android:offset="0.5" android:color="#FF2563EB" />
                <item android:offset="1.0" android:color="#FF38EF7D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Diamond Translucent Fill -->
    <path
        android:pathData="M54,16 L88,54 L54,92 L20,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="16"
                android:endX="88"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A00F2FE" />
                <item android:offset="1.0" android:color="#1A2563EB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Viewfinder Reticle Brackets -->
    <!-- Top-Left Bracket -->
    <path
        android:pathData="M18,30 L18,18 L30,18"
        android:strokeColor="#FF00F2FE"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Top-Right Bracket -->
    <path
        android:pathData="M78,18 L90,18 L90,30"
        android:strokeColor="#FF00F2FE"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom-Left Bracket -->
    <path
        android:pathData="M18,78 L18,90 L30,90"
        android:strokeColor="#FF2563EB"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom-Right Bracket -->
    <path
        android:pathData="M78,90 L90,90 L90,78"
        android:strokeColor="#FF2563EB"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Sharp Futuristic Media Play Prism (Centerpiece) -->
    <path
        android:pathData="M44,36 L72,54 L44,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="36"
                android:endX="72"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00F2FE" />
                <item android:offset="0.6" android:color="#FF38EF7D" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Horizontal Laser Scanline Cutting Through Scene -->
    <path
        android:pathData="M12,54 L96,54"
        android:strokeWidth="2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="54"
                android:endX="96"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#0000F2FE" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#0000F2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Laser Focus Optical Core -->
    <path
        android:pathData="M54,54 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:fillColor="#FFFFFFFF" />

</vector>
