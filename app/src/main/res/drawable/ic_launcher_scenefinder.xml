<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Cosmic Dark Background -->
    <path
        android:pathData="M16,6 L92,6 A10,10 0 0 1 102,16 L102,92 A10,10 0 0 1 92,102 L16,102 A10,10 0 0 1 6,92 L6,16 A10,10 0 0 1 16,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0D0D1A" />
                <item android:offset="0.5" android:color="#FF1A0B2E" />
                <item android:offset="1.0" android:color="#FF061024" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Outer Neon Ring -->
    <path
        android:pathData="M54,18 A36,36 0 1 1 53.9,18 Z"
        android:strokeWidth="3.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF007A" />
                <item android:offset="0.5" android:color="#FF7928CA" />
                <item android:offset="1.0" android:color="#FF00F2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Futuristic Viewfinder Brackets -->
    <!-- Top-Left Bracket -->
    <path
        android:pathData="M24,34 L24,24 L34,24"
        android:strokeColor="#FF00F2FE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Top-Right Bracket -->
    <path
        android:pathData="M74,24 L84,24 L84,34"
        android:strokeColor="#FFFF007A"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom-Left Bracket -->
    <path
        android:pathData="M24,74 L24,84 L34,84"
        android:strokeColor="#FF7928CA"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom-Right Bracket -->
    <path
        android:pathData="M74,84 L84,84 L84,74"
        android:strokeColor="#FF00F2FE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Inner Aperture / Scene Circle -->
    <path
        android:pathData="M54,32 A22,22 0 1 1 53.9,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="32"
                android:endX="76"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#33FF007A" />
                <item android:offset="1.0" android:color="#3300F2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Optical Lens Elements / Aperture Blades -->
    <path
        android:pathData="M54,35 L69,45 L60,63 L45,63 L39,48 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.6">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="35"
                android:endX="69"
                android:endY="63"
                android:type="linear">
                <item android:offset="0.0" android:color="#80FF007A" />
                <item android:offset="0.5" android:color="#807928CA" />
                <item android:offset="1.0" android:color="#8000F2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Glowing Scene Spark (Target) -->
    <path
        android:pathData="M54,46 L56.5,51.5 L62,54 L56.5,56.5 L54,62 L51.5,56.5 L46,54 L51.5,51.5 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Center Lens Core Dot -->
    <path
        android:pathData="M54,52 A2,2 0 1 1 53.9,52 Z"
        android:fillColor="#FF00F2FE" />

</vector>
